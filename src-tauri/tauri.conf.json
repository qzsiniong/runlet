{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Runlet",
  "version": "0.3.1",
  "identifier": "com.runlet.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "runlet"
        ]
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "scripting",
        "title": "Runlet 脚本",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "visible": false,
        "hiddenTitle": true,
        "url": "index.html#/scripting"
      },
      {
        "label": "progress",
        "title": "Runlet 任务进度",
        "width": 420,
        "height": 96,
        "resizable": false,
        "visible": false,
        "hiddenTitle": true,
        "url": "index.html#/progress",
        "alwaysOnTop": true,
        "closable": false,
        "minimizable": false,
        "maximizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "shadow": true,
        "acceptFirstMouse": true
      },
      {
        "label": "script-progress",
        "title": "Runlet 脚本进度",
        "width": 420,
        "height": 110,
        "resizable": false,
        "visible": false,
        "hiddenTitle": true,
        "url": "index.html#/script-progress",
        "alwaysOnTop": true,
        "closable": false,
        "minimizable": false,
        "maximizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "shadow": true,
        "acceptFirstMouse": true
      },
      {
        "label": "standby",
        "title": "Runlet 待命",
        "width": 320,
        "height": 250,
        "resizable": false,
        "visible": false,
        "hiddenTitle": false,
        "url": "index.html#/standby",
        "alwaysOnTop": true,
        "closable": false,
        "minimizable": false,
        "maximizable": false,
        "decorations": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
